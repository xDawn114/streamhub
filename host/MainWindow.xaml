  </Popup>
  <Grid x:Name="BindingDialog" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#66000000" Visibility="Collapsed" Panel.ZIndex="60" PreviewKeyDown="BindingDialog_KeyDown" KeyboardNavigation.TabNavigation="Cycle">
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="10" Padding="24" MaxWidth="620" Margin="24" VerticalAlignment="Center"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource HeaderAction}" Click="CloseBinding_Click"/><TextBlock Text="绑定设备" FontSize="20" FontWeight="SemiBold"/></DockPanel>
    <ScrollViewer Grid.Row="1" MaxHeight="480" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock x:Name="BindingRequestText" Text="在平板上填写电脑 IPv4 和六位短码。" Style="{StaticResource Caption}" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite"/>
     <StackPanel x:Name="BindingEntryPanel">
      <TextBlock Text="电脑 IPv4" Style="{StaticResource Caption}"/>
      <Grid Margin="0,6,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="BindingAddressText" Text="正在读取…" FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.Name="绑定用电脑 IPv4"/>
       <Button x:Name="CopyBindingAddressButton" Grid.Column="1" Click="CopyBindingAddress_Click" Style="{StaticResource HeaderAction}" Margin="12,0,0,0" AutomationProperties.Name="复制绑定用 IPv4 地址"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"/></Button>
      </Grid>
      <TextBlock Text="六位短码" Style="{StaticResource Caption}"/>
      <TextBlock x:Name="BindingCodeText" Text="正在生成…" FontSize="26" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,6,0,8" AutomationProperties.Name="绑定短码"/>
      <TextBlock x:Name="BindingCountdownText" Text="" Style="{StaticResource Caption}"/>
     </StackPanel>
     <StackPanel x:Name="BindingComparisonPanel" Visibility="Collapsed" Margin="0,0,0,16">
      <TextBlock Text="两端校验码" Style="{StaticResource Caption}"/>
      <TextBlock x:Name="BindingComparisonText" FontSize="28" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,6,0,8" AutomationProperties.Name="两端绑定校验码"/>
      <TextBlock Text="与平板显示一致后，允许绑定。" Style="{StaticResource Caption}"/>
     </StackPanel>
     <WrapPanel>
      <Button x:Name="BindingApproveButton" Content="允许绑定" Style="{StaticResource Primary}" Click="ApproveLocalBinding_Click" Visibility="Collapsed" Margin="0,0,8,8"/>
      <Button x:Name="BindingRejectButton" Content="拒绝" Click="RejectLocalBinding_Click" Visibility="Collapsed" Margin="0,0,8,8"/>
     </WrapPanel>
     <WrapPanel Margin="0,8,0,0">
      <Button x:Name="BindingGenerateButton" Content="重新生成短码" Style="{StaticResource HeaderAction}" Click="StartLocalBinding_Click" Margin="0,0,8,0"/>
      <Button x:Name="CancelBindingButton" Content="取消短码" Style="{StaticResource HeaderAction}" Click="CancelLocalBinding_Click" Margin="0,0,8,0" Visibility="Collapsed"/>
     </WrapPanel>
     <TextBlock x:Name="ControlApiStateText" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="Collapsed"/>

     <Expander x:Name="BindingAdvanced" Header="其他绑定方式" Margin="0,14,0,0"><StackPanel><Button Content="复制完整绑定码" Click="CopyDeviceBinding_Click" Margin="0,8,0,12"/>      <Expander x:Name="LegacyPairingDetails" Header="接收端手动配对" Margin="0,0,0,20">
       <StackPanel>
        <TextBlock Text="接收端配对" Style="{StaticResource Heading}" />
        <TextBlock Style="{StaticResource Caption}" Text="填写接收端显示的四位配对码。" Margin="0,0,0,24" />
        <local:SettingRow Header="连接模式" Tag="">
         <ComboBox x:Name="PairMode" SelectedIndex="0" AutomationProperties.Name="连接模式" Width="224">
          <ComboBoxItem Content="远程主屏" Tag="remote" />
          <ComboBoxItem Content="平板副屏" Tag="tablet" />
         </ComboBox>
        </local:SettingRow>
        <local:SettingRow Header="设备名称" Tag="">
         <TextBox x:Name="PairName" Text="我的平板" MaxLength="40" AutomationProperties.Name="设备名称" Width="224" />
        </local:SettingRow>
        <local:SettingRow Header="四位配对码" Tag="">
         <TextBox x:Name="PairPin" MaxLength="4" FontSize="22" FontFamily="Consolas" AutomationProperties.Name="四位配对码" Width="224" />
        </local:SettingRow>
        <Button Content="确认配对" Style="{StaticResource Primary}" Margin="0,24,0,0" Click="Pair_Click" />
       </StackPanel>
      </Expander>
</StackPanel></Expander>
    </StackPanel></ScrollViewer>
   </Grid></Border>
  </Grid>
  <Grid x:Name="DevicePermissionsDialog" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#66000000" Visibility="Collapsed" Panel.ZIndex="64" KeyboardNavigation.TabNavigation="Cycle" KeyDown="DevicePermissions_KeyDown">
   <Border x:Name="DevicePermissionsFrame" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="8" Padding="24" MaxWidth="760" Margin="24">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="设备权限" Style="{StaticResource Heading}" Margin="0,0,0,16"/>
     <ScrollViewer x:Name="DevicePermissionsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,16,12">
      <StackPanel><Border x:Name="FileAccessSettingsCard" Style="{StaticResource Card}">
          <StackPanel>
           <TextBlock Text="文件权限" Style="{StaticResource Heading}" />

           <Expander x:Name="FileAccessDetails" Header="管理授权目录与设备" Margin="0,12,0,0">
            <StackPanel>
             <TextBlock Text="电脑接收目录" FontWeight="SemiBold" Margin="0,12,0,4" />
             <TextBlock x:Name="ReceiveDirectoryText" Text="尚未选择" Style="{StaticResource Caption}" TextWrapping="Wrap" />
             <WrapPanel Margin="0,12,0,0">
              <Button x:Name="OpenReceiveDirectoryButton" Content="打开接收目录" Click="OpenReceiveDirectory_Click" IsEnabled="False" Margin="0,0,8,8" />
              <Button Content="选择接收目录" Click="EnableFiles_Click" Margin="0,0,8,8" />
              <Button Content="关闭文件传输" Click="DisableFiles_Click" Margin="0,0,8,8" />
             </WrapPanel>
             <local:SettingRow Header="允许浏览与下载" Tag="">
              <CheckBox x:Name="BrowseFilesCheck" Click="BrowseFiles_Click" MinHeight="40" AutomationProperties.Name="允许浏览与下载" />
             </local:SettingRow>

             <ListBox x:Name="BrowseRootList" SelectedValuePath="Id" MinHeight="80" Margin="0,12,0,0">
              <ListBox.Style>
               <Style TargetType="ListBox" BasedOn="{StaticResource FileList}">
                <Style.Triggers>
                 <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                </Style.Triggers>
               </Style>
              </ListBox.Style>
              <ListBox.ItemTemplate>
               <DataTemplate>
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
               </DataTemplate>
              </ListBox.ItemTemplate>
             </ListBox>
             <TextBlock x:Name="BrowseRootsEmptyText" Text="尚未添加可浏览目录" Margin="0,12,0,0">
              <TextBlock.Style>
               <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                 <DataTrigger Binding="{Binding HasItems, ElementName=BrowseRootList}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                </Style.Triggers>
               </Style>
              </TextBlock.Style>
             </TextBlock>
             <WrapPanel Margin="0,12,0,0">
              <Button x:Name="AddBrowseRootButton" Content="添加目录" Click="OpenBrowseRootMenu_Click" Margin="0,0,8,8" />
              <Button Content="移除所选目录" Click="RemoveBrowseRoot_Click" Margin="0,0,8,8" />
             </WrapPanel>
             <TextBlock Text="设备授权" FontWeight="SemiBold" Margin="0,8,0,8" />

             <ComboBox x:Name="SettingsFileDeviceBox" SelectedValuePath="ClientId" SelectionChanged="FileDevice_SelectionChanged" Margin="0,8,0,8" AutomationProperties.Name="管理文件设备权限" Width="440" HorizontalAlignment="Left" IsSynchronizedWithCurrentItem="False">
              <ComboBox.ItemTemplate>
               <DataTemplate>
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
               </DataTemplate>
              </ComboBox.ItemTemplate>
             </ComboBox>
             <WrapPanel Margin="0,8,0,0">
              <Button x:Name="FileGrantButton" Content="信任此设备" Tag="allow" Click="GrantFiles_Click" Margin="0,0,8,8" />
              <Button x:Name="FileRevokeButton" Content="撤销文件信任" Tag="deny" Click="GrantFiles_Click" Margin="0,0,8,8" />
              <Button x:Name="FileRemoveButton" Content="移除文件设备" Click="RemoveFileDevice_Click" Margin="0,0,8,8" />
             </WrapPanel>
             <TextBlock x:Name="FileTrustStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
             <local:SettingRow Header="允许上传文件" Tag="">
              <CheckBox x:Name="FileUploadAllowed" MinHeight="40" Click="FilePermission_Changed" AutomationProperties.Name="允许上传文件" />
             </local:SettingRow>
             <local:SettingRow Header="允许移到回收站" Tag="">
              <CheckBox x:Name="FileDeleteAllowed" MinHeight="40" Click="FilePermission_Changed" AutomationProperties.Name="允许移到回收站" />
             </local:SettingRow>
             <TextBlock x:Name="FilePermissionStatus" Style="{StaticResource Caption}" Text="请先选择设备" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
           </Expander>
          </StackPanel>
         </Border>
         <Border Style="{StaticResource Card}" Loaded="ControlDevices_Loaded">
          <StackPanel>
           <TextBlock Text="已绑定设备与权限" Style="{StaticResource Heading}" />
           <TextBlock x:Name="ControlDeviceStateText" Text="正在读取设备授权…" Style="{StaticResource Caption}" TextWrapping="Wrap" />
           <ComboBox x:Name="ControlDeviceBox" SelectedValuePath="Id" SelectionChanged="ControlDevice_Changed" Margin="0,12,0,8" AutomationProperties.Name="独立授权设备" Width="440" HorizontalAlignment="Left">
            <ComboBox.ItemTemplate>
             <DataTemplate>
              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
             </DataTemplate>
            </ComboBox.ItemTemplate>
           </ComboBox>
           <StackPanel x:Name="ControlScopePanel" IsEnabled="False">
            <StackPanel>
             <local:SettingRow Header="远程主屏" Tag="">
              <CheckBox x:Name="ControlRemoteCheck" Click="SaveControlScope_Click" AutomationProperties.Name="远程主屏" />
             </local:SettingRow>
             <local:SettingRow Header="副屏" Tag="">
              <CheckBox x:Name="ControlTabletCheck" Click="SaveControlScope_Click" AutomationProperties.Name="副屏" />
             </local:SettingRow>
             <local:SettingRow Header="文件" Tag="">
              <CheckBox x:Name="ControlFilesCheck" Click="SaveControlScope_Click" AutomationProperties.Name="文件" />
             </local:SettingRow>
             <local:SettingRow Header="会话剪贴板" Tag="">
              <CheckBox x:Name="ControlClipboardCheck" Click="SaveControlScope_Click" AutomationProperties.Name="会话剪贴板" />
             </local:SettingRow>
            </StackPanel>
            <WrapPanel>
             <Button Content="撤销此设备" Style="{StaticResource DangerAction}" Click="RevokeControlDevice_Click" Margin="0,8,8,8" />
             <Button Content="重新绑定" Click="RotateControlDevice_Click" Margin="0,8,0,8" />
            </WrapPanel>
           </StackPanel>
           <local:SettingRow Header="兼容旧版共享绑定" Tag="">
            <CheckBox x:Name="AllowLegacyBindingCheck" MinHeight="40" Click="SaveLegacyBinding_Click" AutomationProperties.Name="兼容旧版共享绑定" />
           </local:SettingRow>

          </StackPanel>
         </Border></StackPanel></ScrollViewer>
     <Border x:Name="DevicePermissionsFooter" Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
      <Button x:Name="DevicePermissionsDoneButton" Content="完成" Click="CloseDevicePermissions_Click" HorizontalAlignment="Right" MinWidth="88"/>
     </Border>
    </Grid>
   </Border>
  </Grid>
  <Grid x:Name="TransportDialog" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#66000000" Visibility="Collapsed" Panel.ZIndex="66" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="TransportDialog_KeyDown">
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="10" Padding="24" MaxWidth="520" Margin="24" VerticalAlignment="Center"><StackPanel>
    <TextBlock x:Name="TransportDialogTitle" Style="{StaticResource Heading}"/>
    <TextBlock x:Name="TransportAddressLabel" Margin="0,12,0,8"/>
    <TextBox x:Name="TransportAddressBox" MaxLength="2048" AutomationProperties.Name="连接通道地址"/>
    <TextBlock Text="保存后应用；更换服务区前请先退出连接账号。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
    <TextBlock x:Name="TransportDialogError" Foreground="{DynamicResource DangerText}" AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0"/>
    <WrapPanel Margin="0,16,0,0"><Button Content="保存" Style="{StaticResource Primary}" Click="SaveTransportDialog_Click" Margin="0,0,8,0"/><Button Content="取消" Click="CloseTransportDialog_Click"/></WrapPanel>
   </StackPanel></Border>
  </Grid>
  <Grid x:Name="AliasDialog" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#66000000" Visibility="Collapsed" Panel.ZIndex="65" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="AliasDialog_KeyDown"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="10" Padding="24" Width="400" VerticalAlignment="Center"><StackPanel><TextBlock Text="设备备注" Style="{StaticResource Heading}"/><TextBlock x:Name="AliasDeviceText" Style="{StaticResource Caption}"/><TextBox x:Name="DeviceAliasBox" MaxLength="40" Margin="0,14,0,8" AutomationProperties.Name="设备备注"/><TextBlock Text="备注只保存在这台电脑；留空恢复设备原名。" Style="{StaticResource Caption}"/><WrapPanel Margin="0,18,0,0"><Button Content="保存" Style="{StaticResource Primary}" Click="SaveDeviceAlias_Click" Margin="0,0,8,0"/><Button Content="取消" Click="CloseDeviceAlias_Click"/></WrapPanel></StackPanel></Border></Grid>
  <Popup x:Name="AcceptancePopover" PlacementTarget="{Binding ElementName=AcceptanceButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Opened="TransientPopover_Opened" PreviewKeyDown="TransientPopover_KeyDown">
   <Border local:FocusInput.Track="True" Style="{StaticResource PopoverFrame}" Width="208" Padding="4" KeyboardNavigation.TabNavigation="Cycle"><StackPanel>
    <Button x:Name="DisconnectActiveButton" Content="断开本次连接" Click="DisconnectActive_Click" Style="{StaticResource PopoverMenuAction}" Visibility="Collapsed"/>
    <Button x:Name="PauseConnectionsButton" Content="暂停接受连接" Click="PauseConnections_Click" Style="{StaticResource PopoverMenuAction}"/>
   </StackPanel></Border>
  </Popup>
  <Popup x:Name="AccountPopover" PlacementTarget="{Binding ElementName=AccountButton}" Placement="Bottom" HorizontalOffset="-264" StaysOpen="False" AllowsTransparency="True" Opened="TransientPopover_Opened" PreviewKeyDown="TransientPopover_KeyDown">
   <Border local:FocusInput.Track="True" Style="{StaticResource PopoverFrame}" Width="304" Padding="16" KeyboardNavigation.TabNavigation="Cycle"><StackPanel>
    <TextBlock Text="网络连接" Style="{StaticResource Heading}"/>
    <TextBlock x:Name="AccountConnectionText" Text="正在读取" TextWrapping="Wrap"/>
    <TextBlock x:Name="AccountConnectionDetailText" Style="{StaticResource Caption}" Visibility="Collapsed" Margin="0,8,0,0"/>
    <Button x:Name="AccountPrimaryButton" Content="连接设置" Click="OpenAccount_Click" Margin="0,16,0,0"/>
   </StackPanel></Border>
  </Popup>
  <Grid x:Name="HelpDialog" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#66000000" Visibility="Collapsed" Panel.ZIndex="66" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="HelpDialog_KeyDown">
   <Border x:Name="HelpFrame" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="10" Padding="24" MaxWidth="640" MaxHeight="620" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <Button x:Name="HelpCloseButton" DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0" Style="{StaticResource HeaderAction}" Click="CloseHelp_Click" AutomationProperties.Name="关闭使用手册" />
      <TextBlock Text="使用手册" Style="{StaticResource Heading}" VerticalAlignment="Center" />
     </DockPanel>
     <ScrollViewer x:Name="HelpScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" ClipToBounds="True" PanningMode="VerticalOnly" Padding="0,0,24,0" SizeChanged="HelpScroller_SizeChanged">
      <StackPanel x:Name="HelpContent" HorizontalAlignment="Left" />
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
