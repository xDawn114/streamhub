    </Button>
   </StackPanel>
  </Grid>
  <TabControl x:Name="Pages" Grid.Row="1" Background="Transparent" BorderThickness="0" TabStripPlacement="Left" Margin="24,20,24,16" SelectionChanged="Pages_SelectionChanged" Grid.Column="1">
   <TabControl.Template>
    <ControlTemplate TargetType="TabControl">
     <Border x:Name="PageViewport" Background="{DynamicResource Surface}">
      <Border.RenderTransform>
       <TranslateTransform />
