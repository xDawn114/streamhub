<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:StreamHub.Host" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="StreamHub.Host.MainWindow" local:FocusInput.Track="True" Title="我控制 · iControl" Width="1080" Height="760" MinWidth="940" MinHeight="660" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource Surface}" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="{DynamicResource TextPrimary}" Loaded="ThemeWindow_Loaded" Closed="ThemeWindow_Closed" StateChanged="ChromeState_Changed" SourceInitialized="ChromeSource_Initialized">
 <shell:WindowChrome.WindowChrome>
