  <Popup x:Name="AccountPopover" PlacementTarget="{Binding ElementName=AccountButton}" Placement="Bottom" HorizontalOffset="-240" StaysOpen="False" AllowsTransparency="True" Opened="TransientPopover_Opened" PreviewKeyDown="TransientPopover_KeyDown"><Border local:FocusInput.Track="True" Style="{StaticResource PopoverFrame}" Width="344" KeyboardNavigation.TabNavigation="Cycle"><StackPanel><TextBlock Text="连接状态" Style="{StaticResource Heading}"/><TextBlock x:Name="AccountConnectionText" Text="正在读取" TextWrapping="Wrap"/><TextBlock x:Name="AccountConnectionDetailText" Style="{StaticResource Caption}" Margin="0,8,0,16"/><Button x:Name="AccountPrimaryButton" Content="启用异地连接" Style="{StaticResource Primary}" Click="AccountPrimary_Click"/><Button Content="更多连接设置 ›" Style="{StaticResource HeaderAction}" Click="OpenAccount_Click" Margin="0,10,0,0"/></StackPanel></Border></Popup>
  <Grid x:Name="HelpDialog" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#66000000" Visibility="Collapsed" Panel.ZIndex="66" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="HelpDialog_KeyDown">
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="10" Padding="24" MaxWidth="640" MaxHeight="620" Margin="24">
    <DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button x:Name="HelpCloseButton" DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0" Style="{StaticResource HeaderAction}" Click="CloseHelp_Click" AutomationProperties.Name="关闭使用手册" />
      <TextBlock Text="使用手册" Style="{StaticResource Heading}" VerticalAlignment="Center" />
     </DockPanel>
     <ScrollViewer x:Name="HelpScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,8,0">
      <StackPanel x:Name="HelpContent" />
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
 </Grid>
