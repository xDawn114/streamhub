    <Button x:Name="CloseWindowButton" Style="{StaticResource CloseCaptionButton}" Click="CloseWindow_Click" ToolTip="关闭到托盘" AutomationProperties.Name="关闭到托盘">
     <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Button>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" IsEnabled="{Binding IsEnabled, ElementName=Pages}">
