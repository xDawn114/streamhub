diff --git a/src/streamhub_first_frame.h b/src/streamhub_first_frame.h
new file mode 100644
index 0000000..d9453e2
--- /dev/null
+++ b/src/streamhub_first_frame.h
@@ -0,0 +1,68 @@
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <optional>
+
+namespace streamhub {
+  enum class first_frame_phase : unsigned {
+    session_start, video_wait_begin, video_ping_ready, capture_begin,
+    encode_device_begin, encode_device_ready, encoder_begin, encoder_ready,
+    initial_idr_queued, idr_requested, first_capture_available, encode_submit,
+    first_idr_encoded, first_idr_dequeued, first_idr_send_begin, first_idr_send_complete,
+    count
+  };
+
+  inline const char *phase_name(first_frame_phase phase) {
+    constexpr const char *names[] = {
+      "session-start", "video-wait-begin", "video-ping-ready", "capture-begin",
+      "encode-device-begin", "encode-device-ready", "encoder-begin", "encoder-ready",
+      "initial-idr-queued", "idr-requested", "first-capture-available", "encode-submit",
+      "first-idr-encoded", "first-idr-dequeued", "first-idr-send-begin", "first-idr-send-complete"
+    };
+    static_assert(sizeof(names) / sizeof(names[0]) == static_cast<unsigned>(first_frame_phase::count));
+    const auto index = static_cast<unsigned>(phase);
+    return index < static_cast<unsigned>(first_frame_phase::count) ? names[index] : "invalid";
+  }
+
+  // Owned by the streaming session, never indexed by a reusable raw pointer.
+  // Each stage logs once across capture/encode/sender threads; late recovery IDRs
+  // do not overwrite startup measurements. No GOP, cache or encoder changes.
+  class first_frame_trace {
+    static_assert(static_cast<unsigned>(first_frame_phase::count) <= 32);
+  public:
+    using clock = std::chrono::steady_clock;
+    struct sample {
+      uint64_t session_id;
+      int64_t origin_us;
+      first_frame_phase phase;
+      int64_t elapsed_ms;
+      int64_t frame_index;
+    };
+    explicit first_frame_trace(clock::time_point started = clock::now()) :
+        id(next_id.fetch_add(1, std::memory_order_relaxed)), started(started) {}
+
+    std::optional<sample> mark(first_frame_phase phase, int64_t frame_index = 0, clock::time_point now = clock::now()) {
+      const auto index = static_cast<unsigned>(phase);
+      if (index >= static_cast<unsigned>(first_frame_phase::count) || now < started) return std::nullopt;
+      const uint32_t bit = uint32_t{1} << index;
+      if (seen.load(std::memory_order_relaxed) & bit) return std::nullopt;
+      if (seen.fetch_or(bit, std::memory_order_relaxed) & bit) return std::nullopt;
+      return sample{id, std::chrono::duration_cast<std::chrono::microseconds>(started.time_since_epoch()).count(),
+        phase, std::chrono::duration_cast<std::chrono::milliseconds>(now - started).count(), frame_index};
+    }
+
+  private:
+    inline static std::atomic<uint64_t> next_id{1};
+    const uint64_t id;
+    const clock::time_point started;
+    std::atomic<uint32_t> seen{0};
+  };
+}
+
+namespace stream {
+  // A null channel is used by capability probes, which must not be logged as
+  // real stream sessions. The implementation lives beside stream::session_t.
+  void first_frame_mark(void *channel_data, streamhub::first_frame_phase phase, int64_t frame_index = 0);
+}
diff --git a/src/streamhub_persisted_probe.h b/src/streamhub_persisted_probe.h
new file mode 100644
index 0000000..e020410
--- /dev/null
+++ b/src/streamhub_persisted_probe.h
@@ -0,0 +1,61 @@
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <string_view>
+
+namespace streamhub {
+  // Capability metadata only. Never contains objects, certificates,
+  // credentials or configuration text. A disk hit still requires real encoding.
+  struct persisted_probe {
+    std::int64_t created = 0;
+    std::string fingerprint;
+    std::string encoder;
+    std::array<std::uint64_t, 3> capabilities {};
+    int hevc_mode = 1;
+    int av1_mode = 1;
+  };
+
+  inline constexpr std::int64_t persisted_probe_max_age = 7 * 24 * 60 * 60;
+
+  inline bool valid_probe_fingerprint(std::string_view text) {
+    if (text.size() != 64) return false;
+    for (char c : text) if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return false;
+    return true;
+  }
+
+  inline std::optional<persisted_probe> decode_persisted_probe(
+      std::string_view bytes, std::string_view fingerprint, std::int64_t now, std::uint64_t flag_mask) {
+    if (bytes.empty() || bytes.size() > 4096 || !valid_probe_fingerprint(fingerprint)) return {};
+    std::istringstream input {std::string(bytes)};
+    persisted_probe result;
+    std::string magic;
+    if (!(input >> magic >> result.created >> result.fingerprint >> result.encoder
+          >> result.capabilities[0] >> result.capabilities[1] >> result.capabilities[2]
+          >> result.hevc_mode >> result.av1_mode)) return {};
+    input >> std::ws;
+    if (!input.eof() || magic != "SHPC1" || result.fingerprint != fingerprint ||
+        result.created < 0 || now < result.created || now - result.created >= persisted_probe_max_age ||
+        result.encoder.empty() || result.encoder.size() > 64 ||
+        result.hevc_mode < 1 || result.hevc_mode > 5 || result.av1_mode < 1 || result.av1_mode > 5) return {};
+    for (char c : result.encoder) if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '-')) return {};
+    for (auto bits : result.capabilities) if (bits & ~flag_mask) return {};
+    // PASSED is bit zero in the pinned encoder ABI. Unknown bits are rejected.
+    if (!(result.capabilities[0] & 1) ||
+        (result.hevc_mode > 1 && !(result.capabilities[1] & 1)) ||
+        (result.av1_mode > 1 && !(result.capabilities[2] & 1))) return {};
+    return result;
+  }
+
+  inline std::string encode_persisted_probe(const persisted_probe &value) {
+    std::ostringstream output;
+    output << "SHPC1\n" << value.created << '\n' << value.fingerprint << '\n' << value.encoder << '\n'
+           << value.capabilities[0] << ' ' << value.capabilities[1] << ' ' << value.capabilities[2] << '\n'
+           << value.hevc_mode << ' ' << value.av1_mode << '\n';
+    return output.str();
+  }
+}
diff --git a/src/streamhub_probe_cache.h b/src/streamhub_probe_cache.h
new file mode 100644
index 0000000..fe45555
--- /dev/null
+++ b/src/streamhub_probe_cache.h
@@ -0,0 +1,38 @@
+#pragma once
+#include <chrono>
+#include <string>
+#include <utility>
+
+namespace streamhub {
+  // Process-local only. Expiry requires a fresh real encoder sample; unknown or
+  // changed identities still need complete probing. Nothing is persisted.
+  class probe_cache_gate {
+  public:
+    using clock = std::chrono::steady_clock;
+    /**
+     * @brief Check whether a real encoder sample may revalidate this target.
+     * @param identity Complete GPU, driver, display and codec identity.
+     * @param now Monotonic observation time; a backwards clock rejects reuse.
+     * @return True only for the same nonempty, previously validated identity.
+     */
+    bool same_target(const std::string &identity, clock::time_point now = clock::now()) const {
+      return !identity.empty() && identity == validated && now >= created;
+    }
+    /**
+     * @brief Check whether the last validation is still within its direct-reuse lifetime.
+     * @param identity Complete target identity.
+     * @param now Monotonic observation time.
+     * @return True only while a matching result is less than fifteen minutes old.
+     */
+    bool matches(const std::string &identity, clock::time_point now = clock::now()) const {
+      return same_target(identity, now) && now - created < std::chrono::minutes(15);
+    }
+    void remember(std::string identity, clock::time_point now = clock::now()) {
+      validated = std::move(identity); created = now;
+    }
+    void invalidate() { validated.clear(); }
+  private:
+    std::string validated;
+    clock::time_point created {};
+  };
+}
diff --git a/src/streamhub_probe_plan.h b/src/streamhub_probe_plan.h
new file mode 100644
index 0000000..87d52a7
--- /dev/null
+++ b/src/streamhub_probe_plan.h
@@ -0,0 +1,15 @@
+#pragma once
+#include <string_view>
+
+namespace streamhub {
+  // Process configuration is immutable during a stream. Unrecognised values
+  // retain upstream full validation; selective plans never advertise untested HDR/chroma.
+  struct probe_plan {
+    std::string_view value;
+    bool basic_only() const {
+      return value == "sdr-auto" || value == "sdr-h264" || value == "sdr-hevc" || value == "sdr-av1";
+    }
+    bool hevc() const { return !basic_only() || value == "sdr-auto" || value == "sdr-hevc"; }
+    bool av1() const { return !basic_only() || value == "sdr-auto" || value == "sdr-av1"; }
+  };
+}
diff --git a/src/streamhub_timing.h b/src/streamhub_timing.h
new file mode 100644
index 0000000..4940b2b
--- /dev/null
+++ b/src/streamhub_timing.h
@@ -0,0 +1,42 @@
+/**
+ * @file src/streamhub_timing.h
+ * @brief Monotonic timing of StreamHub engine startup and launch stages.
+ */
+#pragma once
+
+#include <chrono>
+#include <utility>
+
+#include "logging.h"
+
+namespace streamhub {
+  /** @brief Log one complete stage, including early returns and failures. */
+  class timer {
+    const char *name;
+    std::chrono::steady_clock::time_point started = std::chrono::steady_clock::now();
+
+  public:
+    /** @brief Begin a stage whose name has static storage duration. */
+    explicit timer(const char *name): name(name) {
+      BOOST_LOG(info) << "[StreamHub] begin stage=" << name;
+    }
+
+    /** @brief Finish the stage using elapsed monotonic milliseconds. */
+    ~timer() {
+      BOOST_LOG(info) << "[StreamHub] end stage=" << name << " elapsed_ms=" <<
+        std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - started).count();
+    }
+  };
+
+  /**
+   * @brief Measure a call without changing its return value or ownership.
+   * @param name Stage name with static storage duration.
+   * @param call Operation to execute once.
+   * @return The operation's original result.
+   */
+  template<class F>
+  decltype(auto) measured(const char *name, F &&call) {
+    timer duration(name);
+    return std::forward<F>(call)();
+  }
+}
