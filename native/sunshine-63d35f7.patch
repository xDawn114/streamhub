+++ b/src/streamhub_timing.h
@@ -0,0 +1,42 @@
+/**
+ * @file src/streamhub_timing.h
+ * @brief Monotonic timing of StreamHub engine startup and launch stages.
+ */
+#pragma once
+
+#include <chrono>
+#include <utility>
+
+#include "logging.h"
+
+namespace streamhub {
+  /** @brief Log one complete stage, including early returns and failures. */
+  class timer {
+    const char *name;
+    std::chrono::steady_clock::time_point started = std::chrono::steady_clock::now();
+
+  public:
+    /** @brief Begin a stage whose name has static storage duration. */
+    explicit timer(const char *name): name(name) {
+      BOOST_LOG(info) << "[StreamHub] begin stage=" << name;
+    }
+
+    /** @brief Finish the stage using elapsed monotonic milliseconds. */
+    ~timer() {
+      BOOST_LOG(info) << "[StreamHub] end stage=" << name << " elapsed_ms=" <<
+        std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - started).count();
+    }
+  };
+
+  /**
+   * @brief Measure a call without changing its return value or ownership.
+   * @param name Stage name with static storage duration.
+   * @param call Operation to execute once.
+   * @return The operation's original result.
+   */
+  template<class F>
+  decltype(auto) measured(const char *name, F &&call) {
+    timer duration(name);
+    return std::forward<F>(call)();
+  }
+}
