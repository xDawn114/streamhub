+#include <utility>
+
+namespace streamhub {
+  // Process-local only. Unknown identities, timeout, failures and mode changes
+  // cannot reuse capability flags. No GPU capability is invented or persisted.
+  class probe_cache_gate {
+  public:
+    using clock = std::chrono::steady_clock;
+    bool matches(const std::string &identity, clock::time_point now = clock::now()) const {
+      return !identity.empty() && identity == validated && now >= created && now - created < std::chrono::minutes(15);
+    }
+    void remember(std::string identity, clock::time_point now = clock::now()) {
+      validated = std::move(identity); created = now;
+    }
+    void invalidate() { validated.clear(); }
+  private:
+    std::string validated;
+    clock::time_point created {};
+  };
+}
