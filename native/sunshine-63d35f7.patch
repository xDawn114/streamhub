+  std::string streamhub_encoder_environment(const std::string &output_name) {
+    dxgi::factory1_t factory;
+    if (FAILED(CreateDXGIFactory1(IID_IDXGIFactory1, (void **) &factory))) return {};
+    const auto requested_adapter = utf_utils::from_utf8(config::video.adapter_name);
+    std::string result;
+    dxgi::adapter_t::pointer adapter_p {};
+    for (UINT i = 0; factory->EnumAdapters1(i, &adapter_p) != DXGI_ERROR_NOT_FOUND; ++i) {
+      dxgi::adapter_t adapter {adapter_p};
+      DXGI_ADAPTER_DESC1 gpu {};
+      if (FAILED(adapter->GetDesc1(&gpu))) return {};
+      if (!requested_adapter.empty() && requested_adapter != gpu.Description) continue;
+      LARGE_INTEGER driver {};
+      if (FAILED(adapter->CheckInterfaceSupport(__uuidof(IDXGIDevice), &driver))) return {};
+      dxgi::output_t::pointer output_p {};
+      for (UINT j = 0; adapter->EnumOutputs(j, &output_p) != DXGI_ERROR_NOT_FOUND; ++j) {
+        dxgi::output_t output {output_p};
+        DXGI_OUTPUT_DESC screen {};
+        if (FAILED(output->GetDesc(&screen))) return {};
+        if (!screen.AttachedToDesktop || (!output_name.empty() && utf_utils::to_utf8(screen.DeviceName) != output_name)) continue;
+        // Auto output on multiple monitors is ambiguous: retain full probing.
+        if (!result.empty()) return {};
+        DEVMODEW mode {}; mode.dmSize = sizeof(mode);
+        if (!EnumDisplaySettingsExW(screen.DeviceName, ENUM_CURRENT_SETTINGS, &mode, 0)) return {};
+        UINT path_count = 0, mode_count = 0;
+        if (GetDisplayConfigBufferSizes(QDC_ONLY_ACTIVE_PATHS, &path_count, &mode_count) != ERROR_SUCCESS || path_count > 64 || mode_count > 256) return {};
+        std::vector<DISPLAYCONFIG_PATH_INFO> paths(path_count);
+        std::vector<DISPLAYCONFIG_MODE_INFO> modes(mode_count);
+        if (QueryDisplayConfig(QDC_ONLY_ACTIVE_PATHS, &path_count, paths.data(), &mode_count, modes.data(), nullptr) != ERROR_SUCCESS) return {};
+        std::string ccd;
+        for (UINT path_index = 0; path_index < path_count; ++path_index) {
+          const auto &path = paths[path_index];
+          DISPLAYCONFIG_SOURCE_DEVICE_NAME source {};
+          source.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_SOURCE_NAME;
+          source.header.size = sizeof(source); source.header.adapterId = path.sourceInfo.adapterId; source.header.id = path.sourceInfo.id;
+          if (DisplayConfigGetDeviceInfo(&source.header) != ERROR_SUCCESS || std::wstring(source.viewGdiDeviceName) != screen.DeviceName) continue;
+          if (!ccd.empty()) return {}; // Cloned outputs cannot share one unambiguous cache entry.
+          std::ostringstream exact_mode;
+          exact_mode << path.targetInfo.adapterId.HighPart << ':' << path.targetInfo.adapterId.LowPart << ':' << path.targetInfo.id
+                     << ':' << path.targetInfo.refreshRate.Numerator << '/' << path.targetInfo.refreshRate.Denominator
+                     << ':' << path.targetInfo.rotation << ':' << path.targetInfo.scaling << ':' << path.targetInfo.scanLineOrdering;
+          ccd = exact_mode.str();
+        }
+        if (ccd.empty()) return {};
+        IDXGIOutput6 *modern = nullptr;
+        if (FAILED(output->QueryInterface(__uuidof(IDXGIOutput6), (void **) &modern))) return {};
+        DXGI_OUTPUT_DESC1 color {};
+        const auto color_status = modern->GetDesc1(&color); modern->Release();
+        if (FAILED(color_status)) return {};
+        std::ostringstream key;
+        key << gpu.AdapterLuid.HighPart << ':' << gpu.AdapterLuid.LowPart << ':' << gpu.VendorId << ':' << gpu.DeviceId
+            << ':' << gpu.SubSysId << ':' << gpu.Revision << ':' << driver.QuadPart << ':' << utf_utils::to_utf8(screen.DeviceName)
+            << ':' << mode.dmPelsWidth << ':' << mode.dmPelsHeight << ':' << mode.dmDisplayFrequency << ':' << mode.dmBitsPerPel
+            << ':' << mode.dmDisplayOrientation << ':' << screen.Rotation << ':' << color.ColorSpace << ':' << color.BitsPerColor << ':' << ccd;
+        result = key.str();
+      }
+    }
+    return result;
+  }
